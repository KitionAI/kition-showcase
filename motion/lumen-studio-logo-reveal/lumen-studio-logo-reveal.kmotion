                            "t": "Vec2",
                            "v": [
                              640.0,
                              360.0
                            ]
                          },
                          "expr": {
                            "text": "// Sheen centre: sweeps once across the layer as Sheen Progress goes 0 to 1.\nvar r = sourceRectAtTime(time, false), p = effect(\"Sheen Progress\")(\"Slider\");\nvar a = 25.000000 * Math.PI / 180, c = Math.max(Math.abs(Math.cos(a)), 0.05), tn = Math.abs(Math.tan(a));\nvar m = (r.width * 0.800000 / 2) / c + tn * r.height / 2 + 2;\n[r.left - m + p * (r.width + 2 * m) - -640.000000, r.top + r.height / 2 - -360.000000];",
                            "enabled": true
                          },
                          "ui": {
                            "kind": "Point"
