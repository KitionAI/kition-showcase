                          "roving": false
                        }
                      ],
                      "expr": {
                        "text": "// Promo spring (damping 15, stiffness 190, mass 1): the motion into the last key.\nvar n = numKeys;\nif (n < 2) { value; } else {\nvar a = key(n - 1), b = key(n), t = time - a.time;\nif (t <= 0) { value; } else {\nvar m = 1, k = 190, c = 15;\nvar w0 = Math.sqrt(k / m), z = c / (2 * Math.sqrt(k * m)), p;\nif (z < 1) { var wd = w0 * Math.sqrt(1 - z * z); p = 1 - Math.exp(-z * w0 * t) * (Math.cos(wd * t) + (z * w0 / wd) * Math.sin(wd * t)); }\nelse if (z == 1) { p = 1 - Math.exp(-w0 * t) * (1 + w0 * t); }\nelse { var s = Math.sqrt(z * z - 1), r1 = -w0 * (z - s), r2 = -w0 * (z + s); p = 1 + (r2 * Math.exp(r1 * t) - r1 * Math.exp(r2 * t)) / (r1 - r2); }\na.value + (b.value - a.value) * p;\n}\n}",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Angle"
                      },
                      "spatial": false,
                      "hold_only": false,
