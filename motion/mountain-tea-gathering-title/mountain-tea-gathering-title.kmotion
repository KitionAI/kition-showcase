                                      "expr": {
                                        "text": "function promoEase(p){if(p<=0)return 0;if(p>=1)return 1;var ax=1-3*0.36+3*0.22,bx=3*0.36-6*0.22,cx=3*0.22,ay=1-3*1+3*1,by=3*1-6*1,cy=3*1;var u=p;for(var i=0;i<8;i++){var e=((ax*u+bx)*u+cx)*u-p;var d=(3*ax*u+2*bx)*u+cx;if(Math.abs(e)<1e-7||Math.abs(d)<1e-7)break;u=u-e/d;}if(!(u>=0&&u<=1)||Math.abs(((ax*u+bx)*u+cx)*u-p)>1e-5){var lo=0,hi=1;for(var j=0;j<40;j++){u=(lo+hi)/2;if(((ax*u+bx)*u+cx)*u<p)lo=u;else hi=u;}}return ((ay*u+by)*u+cy)*u;}\nvar i = textIndex - 1;\nif (i < 0) { 0; } else { var t = (time - 0.400000 - i * 0.133333) / 0.733333; 100 * (1 - promoEase(t < 0 ? 0 : (t > 1 ? 1 : t))); }",
                                        "enabled": true
                                      },
