              "enabled": true,
              "children": [
                {
                  "node": "Group",
                  "uid": 805,
                  "match": "text",
                  "name": "Text",
                  "kind": {
                    "kind": "Plain"
                  },
                  "enabled": true,
                  "children": [
                    {
                      "node": "Prop",
                      "uid": 791,
                      "match": "sourceText",
                      "name": "Source Text",
                      "value": {
                        "t": "Text",
                        "v": {
                          "text": "93",
                          "font": "Inter",
                          "style": "Bold",
                          "size": 40.0,
                          "fill": [
                            1.0,
                            1.0,
                            1.0,
                            1.0
                          ],
                          "stroke": [
                            0.0,
                            0.0,
                            0.0,
                            1.0
                          ],
                          "stroke_width": 0.0,
                          "apply_fill": true,
                          "apply_stroke": false,
                          "stroke_over_fill": true,
                          "tracking": 0.0,
                          "leading": null,
                          "justify": "Center",
