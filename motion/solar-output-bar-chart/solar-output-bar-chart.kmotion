              "children": [
                {
                  "node": "Group",
                  "uid": 509,
                  "match": "text",
                  "name": "Text",
                  "kind": {
                    "kind": "Plain"
                  },
                  "enabled": true,
                  "children": [
                    {
                      "node": "Prop",
                      "uid": 495,
                      "match": "sourceText",
                      "name": "Source Text",
                      "value": {
                        "t": "Text",
                        "v": {
                          "text": "58",
                          "font": "Inter",
                          "style": "Bold",
                          "size": 40.0,
                          "fill": [
                            1.0,
                            1.0,
                            1.0,
                            1.0
                          ],
                          "stroke": [
                            0.0,
                            0.0,
                            0.0,
