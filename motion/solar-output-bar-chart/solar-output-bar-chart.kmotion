                          "box_size": null,
                          "box_pos": [
                            0.0,
                            0.0
                          ],
                          "tsume": 0.0,
                          "baseline": "Normal",
                          "kerning": "Metrics",
                          "ligatures": true,
                          "tate_chu_yoko": false,
                          "vertical_roman_upright": false,
                          "opentype": {
                            "discretionary_ligatures": false,
                            "contextual_alternates": true,
                            "stylistic_alternates": false,
                            "stylistic_sets": 0,
                            "swash": false,
                            "titling": false,
                            "ordinals": false,
                            "fractions": false,
                            "all_small_caps": false,
                            "figure_style": "Default",
                            "figure_width": "Tabular"
                          },
                          "indent_left": 0.0,
                          "indent_right": 0.0,
                          "indent_first": 0.0,
                          "space_before": 0.0,
                          "space_after": 0.0,
                          "direction": "Ltr",
                          "composer": "EveryLine",
                          "hanging_punctuation": false,
                          "vertical": false
                        }
                      },
                      "expr": {
                        "text": "// Count Up: 0 to 71 over 0.9 s, expo-out.\nvar x = (time - 1.200000) / 0.900000;\nx = x < 0 ? 0 : (x > 1 ? 1 : x);\nvar e = x >= 1 ? 1 : 1 - Math.pow(2, -10 * x);\nvar v = 0.000000 + (71.000000 - 0.000000) * e, neg = v < 0;\nvar parts = Math.abs(v).toFixed(0).split(\".\"), ip = parts[0], out = \"\";\nwhile (ip.length > 3) { out = \",\" + ip.slice(ip.length - 3) + out; ip = ip.slice(0, ip.length - 3); }\nout = ip + out + (parts.length > 1 ? \".\" + parts[1] : \"\");\n\"\" + (neg ? \"-\" : \"\") + out + \"\";",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Text"
                      },
                      "spatial": false,
                      "hold_only": true,
                      "three_d_only": false,
                      "two_d_only": false,
                      "shown_dims": 0,
                      "static_only": false
